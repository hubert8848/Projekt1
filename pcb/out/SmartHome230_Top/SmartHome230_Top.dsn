(pcb "SmartHome230_Top".dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "pcbforge")
    (host_version "1.0")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary (path pcb 0  0 0  1300000 0  1300000 -1150000  0 -1150000  0 0))
    (via "Via_8000_4000")
    (rule (width 2500) (clearance 2000) (clearance 2000 (type default_smd)) (clearance 2000 (type smd_smd)))
  )
  (placement
    (component "MountingHole_M3"
