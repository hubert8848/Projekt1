      (place "H2" 1225000 -225000 front 0)
      (place "H3" 1225000 -925000 front 0)
      (place "H4" 75000 -925000 front 0)
    )
    (component "PinHeader_2x10_P2.54mm"
      (place "J1" 650000 -575000 front 0)
    )
    (component "SOIC-28"
      (place "U1" 176500 -284900 front 0)
    )
    (component "C_0805"
      (place "C1" 309000 -198200 back 0)
    )
    (component "R_0805"
      (place "R1" 348000 -198200 back 0)
      (place "R2" 387000 -198200 back 0)
      (place "R3" 426000 -198200 back 0)
    )
    (component "D_SOD-323"
      (place "D1" 467500 -198200 front 0)
    )
    (component "TO-92"
      (place "U2" 257000 -215000 front 0)
    )
  )
  (library
