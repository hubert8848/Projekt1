    (net "BTN0" (pins J1-10 U1-21))
    (net "BTN1" (pins J1-11 U1-22))
    (net "BTN2" (pins J1-12 U1-23))
    (net "BTN3" (pins J1-13 U1-24))
    (net "BTN4" (pins J1-14 U1-25))
    (net "BTN5" (pins J1-15 U1-26))
    (net "BTN6" (pins J1-16 U1-27))
    (net "BTN7" (pins J1-17 U1-28))
    (net "EXP_INT" (pins J1-7 U1-20))
    (net "EXP_RST" (pins J1-8 U1-18))
    (net "GND" (pins J1-1 J1-2 J1-18 J1-20 U1-10 U1-15 U1-16 U1-17 C1-2 D1-2 U2-1))
    (net "OW" (pins J1-9 R3-2 D1-1 U2-2))
    (net "SCL" (pins J1-6 U1-12 R2-2))
    (net "SDA" (pins J1-5 U1-13 R1-2))
